{
  "$schema": "vscode://schemas/color-theme",
  "name": "CodeParity",
  "type": "dark",
  "colors": {
    "editor.background": "#202124", "editor.foreground": "#d6d3c8",
    "editorLineNumber.foreground": "#a39d90", "editorLineNumber.activeForeground": "#d6b66d",
    "editor.lineHighlightBackground": "#282a2d", "editor.selectionBackground": "#484a4e",
    "editorCursor.foreground": "#83a6a0", "editorWhitespace.foreground": "#484a4e",
    "editorIndentGuide.background": "#34363a", "editorIndentGuide.activeBackground": "#484a4e",
    "editorWidget.background": "#282a2d", "editorWidget.border": "#484a4e",
    "sideBar.background": "#282a2d", "sideBar.foreground": "#d6d3c8",
    "activityBar.background": "#202124", "statusBar.background": "#34363a",
    "statusBar.foreground": "#d6d3c8", "titleBar.activeBackground": "#202124",
    "titleBar.activeForeground": "#d6d3c8", "panel.background": "#202124",
    "panel.border": "#34363a", "terminal.foreground": "#d6d3c8",
    "terminal.background": "#202124", "terminal.ansiBlack": "#202124",
    "terminal.ansiRed": "#e47769", "terminal.ansiGreen": "#a9ad68",
    "terminal.ansiYellow": "#d6b66d", "terminal.ansiBlue": "#83a6a0",
    "terminal.ansiMagenta": "#c08ca3", "terminal.ansiCyan": "#91ad85",
    "terminal.ansiWhite": "#a39d90", "terminal.ansiBrightBlack": "#484a4e",
    "terminal.ansiBrightWhite": "#d6d3c8"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#a39d90", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#e47769", "fontStyle": "bold" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#a9ad68" } },
    { "scope": ["entity.name.type", "support.type", "constant.language"], "settings": { "foreground": "#d6b66d" } },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#a9ad68" } },
    { "scope": ["constant.numeric", "constant"], "settings": { "foreground": "#c08ca3" } },
    { "scope": ["variable", "entity.name.variable"], "settings": { "foreground": "#83a6a0" } },
    { "scope": ["entity.name.tag", "entity.name.selector"], "settings": { "foreground": "#d8965f" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#91ad85" } },
    { "scope": ["invalid"], "settings": { "foreground": "#e47769", "fontStyle": "underline" } }
  ]
}
