{
  "$schema": "vscode://schemas/color-theme",
  "name": "CodeParity",
  "type": "dark",
  "colors": {
    "editor.background": "#181818", "editor.foreground": "#ebdbb2",
    "editorLineNumber.foreground": "#a89984", "editorLineNumber.activeForeground": "#fabd2f",
    "editor.lineHighlightBackground": "#1e1e1e", "editor.selectionBackground": "#3a3a3a",
    "editorCursor.foreground": "#83a598", "editorWhitespace.foreground": "#3a3a3a",
    "editorIndentGuide.background": "#2a2a2a", "editorIndentGuide.activeBackground": "#3a3a3a",
    "editorWidget.background": "#1e1e1e", "editorWidget.border": "#3a3a3a",
    "sideBar.background": "#1e1e1e", "sideBar.foreground": "#ebdbb2",
    "activityBar.background": "#181818", "statusBar.background": "#2a2a2a",
    "statusBar.foreground": "#ebdbb2", "titleBar.activeBackground": "#181818",
    "titleBar.activeForeground": "#ebdbb2", "panel.background": "#181818",
    "panel.border": "#2a2a2a", "terminal.foreground": "#ebdbb2",
    "terminal.background": "#181818", "terminal.ansiBlack": "#181818",
    "terminal.ansiRed": "#fb4934", "terminal.ansiGreen": "#b8bb26",
    "terminal.ansiYellow": "#fabd2f", "terminal.ansiBlue": "#83a598",
    "terminal.ansiMagenta": "#d3869b", "terminal.ansiCyan": "#8ec07c",
    "terminal.ansiWhite": "#a89984", "terminal.ansiBrightBlack": "#3a3a3a",
    "terminal.ansiBrightWhite": "#ebdbb2"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#a89984", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#fb4934", "fontStyle": "bold" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#b8bb26" } },
    { "scope": ["entity.name.type", "support.type", "constant.language"], "settings": { "foreground": "#fabd2f" } },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#b8bb26" } },
    { "scope": ["constant.numeric", "constant"], "settings": { "foreground": "#d3869b" } },
    { "scope": ["variable", "entity.name.variable"], "settings": { "foreground": "#83a598" } },
    { "scope": ["entity.name.tag", "entity.name.selector"], "settings": { "foreground": "#fe8019" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#8ec07c" } },
    { "scope": ["invalid"], "settings": { "foreground": "#fb4934", "fontStyle": "underline" } }
  ]
}
